<?xml version="1.0" encoding="utf-8"?>
<!--
  Chỉ cho phép HTTP thường (cleartext) tới localhost/loopback — dùng khi flavor `dev` trỏ
  backend local qua `adb reverse tcp:8080 tcp:8080` (xem apps/customer_app/lib/main_dev.dart).
  Android 9+ (targetSdk 28+) chặn cleartext mặc định; KHÔNG bật cleartext toàn cục
  (`usesCleartextTraffic="true"`) vì staging/prod luôn dùng HTTPS thật.
-->
<network-security-config>
    <domain-config cleartextTrafficPermitted="true">
        <domain includeSubdomains="false">localhost</domain>
        <domain includeSubdomains="false">127.0.0.1</domain>
        <domain includeSubdomains="false">10.0.2.2</domain>
    </domain-config>
</network-security-config>
