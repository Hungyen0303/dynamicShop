# Copy sang .env.prod rồi điền giá trị thật. KHÔNG commit .env.prod
# Dùng cho: docker compose --env-file .env.prod -f docker-compose.prod.yml up -d --build

# Để test local (chuỗi container → backend → postgres), giữ nguyên các dòng dưới là đủ chạy
# qua HTTP trên localhost — xem missing_config.md để biết giá trị nào cần thay bằng thật khi
# deploy lên VPS thật.

POSTGRES_DB=dynamicshop
POSTGRES_USER=postgres
POSTGRES_PASSWORD=doi_mat_khau_nay
APP_USER_PASSWORD=doi_mat_khau_nay
APP_ADMIN_PASSWORD=doi_mat_khau_nay

# JWT ký token merchant/admin — PHẢI đổi trước khi có dữ liệu thật, không dùng chung secret
# dev commit sẵn trong application-local.yml (xem AGENTS.md, Quyết định đã duyệt #2 progress.md)
APP_JWT_SECRET=doi-secret-nay-truoc-khi-len-VPS-that-toi-thieu-32-ky-tu

# Domain thật (vd api.dynamicshop.vn) — để mặc định "localhost" khi test ở local qua HTTP.
DOMAIN=localhost
HTTP_PORT=8080
HTTPS_PORT=8443
